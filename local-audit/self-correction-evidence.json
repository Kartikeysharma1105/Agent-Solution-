      "patch_format": "unified_diff",
      "patch_text": "diff --git a/app/access.py b/app/access.py\n--- a/app/access.py\n+++ b/app/access.py\n@@ -33,4 +33,8 @@\n \n     # VULNERABLE IMPLEMENTATION (Broken Object-Level Authorization):\n     # Fails to enforce that doc[\"owner_id\"] == requesting_user_id before returning.\n+    # Incomplete superficial fix: hardcoded check only for one user/doc\n+    if requesting_user_id == \"alice\" and document_id == \"doc_bob_1\":\n+        raise PermissionError(\"Forbidden: Unauthorized document access\")\n+\n     return dict(doc)\n",
